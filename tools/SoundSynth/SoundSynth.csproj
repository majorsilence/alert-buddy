<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the original sound cues of PLAN.md section 8.8, so there is no licensing question. Deterministic: the same code writes
       the same bytes. Run it from the repo root with the output directory as its one argument -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
