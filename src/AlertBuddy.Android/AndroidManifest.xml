<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Debug builds are given this permission automatically and Release builds are not, so without it a shipped build cannot open a
       socket at all. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Alert notifications (a runtime permission from Android 13). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- The listener runs as a foreground service, of the special-use type: see docs/android-background.md. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Start listening again after a restart. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Let an alarm take over the screen where Android allows it. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <application android:allowBackup="true" android:label="AlertBuddy" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
    <service android:name="alertbuddy.ListenerService" android:exported="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection to the family's own ntfy server open so a temperature alarm is heard with the screen off. It is not a media, location or data-sync task." />
    </service>
  </application>
</manifest>
