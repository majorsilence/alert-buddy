<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Debug builds are given this permission automatically and Release builds are not, so without it a shipped build cannot open a
       socket at all. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:allowBackup="true" android:label="AlertBuddy"></application>
</manifest>
