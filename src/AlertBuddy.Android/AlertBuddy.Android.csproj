<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android head. Needs the `android` workload: `dotnet workload install android`. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.majorsilence.alertbuddy</ApplicationId>
    <!-- The version code is what Android compares to accept an update: the same number as the installed copy, or a lower one, is refused on
         some devices. It is the minutes since 2026-01-01, so every build is newer than the last (an int holds it until the year 6000). A
         published release would set it by hand. -->
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">$([System.Math]::Floor($([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2026-01-01T00:00:00Z').ToUniversalTime())).TotalMinutes)))</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms.Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <ProjectReference Include="..\AlertBuddy.Shared\AlertBuddy.Shared.csproj" />
  </ItemGroup>


</Project>
