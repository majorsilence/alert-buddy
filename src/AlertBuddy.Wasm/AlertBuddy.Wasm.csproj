<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The browser / WebAssembly head. `dotnet build` compiles it; only `dotnet publish` runs the
       wasm-tools pipeline that produces a servable bundle, so it needs that workload:
       `dotnet workload install wasm-tools`. Serve bin/Release/net10.0-browser/publish/wwwroot with
       any static file server. -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- The JavaScript interop of BrowserSoundPlayer is generated code that needs this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The cues are generated by tools/SoundSynth into the Android head's assets, the one place they are kept; the page serves the same files
       from sounds/. -->
  <ItemGroup>
    <Content Include="..\AlertBuddy.Android\Assets\sounds\*.wav" Link="wwwroot\sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms.Avalonia" />
    <PackageReference Include="Avalonia.Browser" />
    <ProjectReference Include="..\AlertBuddy.Shared\AlertBuddy.Shared.csproj" />
  </ItemGroup>

</Project>
