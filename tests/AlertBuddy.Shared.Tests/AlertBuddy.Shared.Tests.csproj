<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI tests on the framework's Headless backend: render each screen and control to a PNG with no display, drive
       it through the automation tree, and compare against golden images (PLAN.md section 10). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Majorsilence.Forms.Headless" />
    <ProjectReference Include="..\..\src\AlertBuddy.Shared\AlertBuddy.Shared.csproj" />
  </ItemGroup>

</Project>
